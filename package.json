{
  "name": "svelte-p5-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte 5 + p5.js integration toolkit — layered primitives, components, and patterns",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edw1nzhao/svelte-p5.git"
  },
  "homepage": "https://github.com/edw1nzhao/svelte-p5#readme",
  "bugs": {
    "url": "https://github.com/edw1nzhao/svelte-p5/issues"
  },
  "author": "Edwin Zhao",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter @svelte-p5/e2e test:browser",
    "prepare": "husky",
    "docs:upgrade": "node scripts/build-upgrade-doc.mjs",
    "docs:upgrade:check": "node scripts/build-upgrade-doc.mjs --check",
    "check:peers": "node scripts/check-peer-ranges.mjs",
    "check:package": "node scripts/check-package-types.mjs",
    "smoke:consumer": "node scripts/consumer-smoke/run.mjs",
    "docs:snippets": "node scripts/check-doc-snippets.mjs",
    "docs:links": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "semver": "^7.8.5",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  }
}
